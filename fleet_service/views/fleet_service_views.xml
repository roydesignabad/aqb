<odoo>
  <data>

    <!-- Tree View -->
    <record model="ir.ui.view" id="fleet_service_list">
      <field name="name">fleet.service.record.tree</field>
      <field name="model">fleet.service.record</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="vehicle_id"/>
          <field name="service_date"/>
          <field name="service_type"/>
          <field name="cost"/>
          <field name="state"/>
        </tree>
      </field>
    </record>

    <!-- Form View -->
    <record model="ir.ui.view" id="fleet_service_form">
      <field name="name">fleet.service.record.form</field>
      <field name="model">fleet.service.record</field>
      <field name="arch" type="xml">
        <form string="Service Record">

          <header>
            <button name="action_start" string="Start" type="object"
                    invisible="state != 'draft'"/>

            <button name="action_done" string="Done" type="object"
                    invisible="state != 'in_progress'"/>

            <button name="action_cancel" string="Cancel" type="object"
                    invisible="state not in ('draft','in_progress')"/>

            <button name="action_reset_draft" string="Reset" type="object"
                    invisible="state != 'cancelled'"/>
            <field name="state" widget="statusbar"/>
          </header>

          <sheet>
            <group>
              <field name="name"/>
              <field name="vehicle_id"/>
              <field name="service_date"/>
              <field name="service_type"/>
              <field name="cost"/>
            </group>

            <notebook>
              <page string="Service Lines">
                <field name="service_line_ids">
                  <tree editable="bottom">
                    <field name="description"/>
                    <field name="quantity"/>
                    <field name="unit_price"/>
                  </tree>
                </field>
              </page>

              <page string="Notes">
                <field name="notes"/>
              </page>
            </notebook>

          </sheet>

        </form>
      </field>
    </record>

    <!-- Action -->
    <record id="action_fleet_service" model="ir.actions.act_window">
      <field name="name">Service Records</field>
      <field name="res_model">fleet.service.record</field>
      <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_fleet_service_root" name="Fleet Service"/>
    <menuitem id="menu_fleet_service"
              name="Service Records"
              parent="menu_fleet_service_root"
              action="action_fleet_service"/>

  </data>
</odoo>